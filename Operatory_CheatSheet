// ========================================================================================
// 3. SLOŽENÉ PŘIŘAZENÍ (+=, -=, *=, /=)
// Mění přímo aktuální objekt (levý operand). Vrací referenci na sebe sama (*this).
// ========================================================================================
class Nadrz {
private:
    double litryPaliva;
public:
    Nadrz(double l) : litryPaliva(l) {}

    // SYNTAXE: Trida& operator+=(const Typ& hodnota);
    Nadrz& operator+=(double pridavek) {
        this->litryPaliva += pridavek;
        return *this; // Dereference this ukazatele vrátí samotný objekt
    }

    Nadrz& operator-=(double ubytek) {
        this->litryPaliva -= ubytek;
        if(this->litryPaliva < 0) this->litryPaliva = 0;
        return *this;
    }
};
/* --- POUŽITÍ ---
