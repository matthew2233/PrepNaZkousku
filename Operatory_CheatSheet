kanystr += 5.5; // Nyni obsahuje 15.5 litru
*/


// ========================================================================================
// 4. RELAČNÍ (POROVNÁVACÍ) OPERÁTORY (==, !=, <, >, <=, >=)
// Vrací vždy bool (true/false) a musí být const (objekty pouze čtou).
// ========================================================================================
class Teplomer {
private:
    double stupneCelsia;
public:
    Teplomer(double teplota) : stupneCelsia(teplota) {}

    // SYNTAXE: bool operator==(const Trida& other) const;
    bool operator==(const Teplomer& other) const {
        return this->stupneCelsia == other.stupneCelsia;
    }

    // != je nejlepší implementovat jako negaci ==
    bool operator!=(const Teplomer& other) const {
        return !(*this == other); 
    }

    bool operator<(const Teplomer& other) const {
        return this->stupneCelsia < other.stupneCelsia;
    }
};
