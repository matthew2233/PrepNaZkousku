// ========================================================================================
// 8. FUNKTOR - OPERÁTOR VOLÁNÍ FUNKCE ()
// Umožňuje chovat se k objektu jako k funkci.
// ========================================================================================
class PrevodnikJednotek {
private:
    double koeficient;
public:
    PrevodnikJednotek(double k) : koeficient(k) {}

    // SYNTAXE: Typ operator()(Parametry...) const;
    double operator()(double hodnota) const {
        return hodnota * koeficient;
    }
};
