// ========================================================================================
// 2. ARITMETICKÉ OPERÁTORY (+, -, *, /)
// Nemění původní objekty, ale vrací zcela nový objekt jako výsledek.
// ========================================================================================
class Vektor2D {
public:
    int x, y;
    Vektor2D(int x, int y) : x(x), y(y) {}

    // SYNTAXE: Trida operator+(const Trida& other) const;
    // 'const' na konci, protože sčítáním se tento (levý) vektor nemění.
    Vektor2D operator+(const Vektor2D& other) const {
        return Vektor2D(this->x + other.x, this->y + other.y);
    }

    Vektor2D operator-(const Vektor2D& other) const {
        return Vektor2D(this->x - other.x, this->y - other.y);
    }
};
