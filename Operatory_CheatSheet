*/


// ========================================================================================
// 6. OPERÁTOR INDEXACE ([])
// Dvě verze: jedna pro zápis/čtení (vrací referenci) a druhá const (jen pro čtení).
// ========================================================================================
class Skladiste {
private:
    vector<string> polozky;
public:
    Skladiste(vector<string> p) : polozky(p) {}

    // 1. Verze pro zápis i čtení (vrací referenci)
    string& operator[](int index) {
        return polozky[index];
    }

    // 2. Verze pouze pro const čtení
    const string& operator[](int index) const {
        return polozky[index];
    }
};
