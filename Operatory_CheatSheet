// ========================================================================================
// 1. OPERÁTORY PRO VÝPIS A NAČÍTÁNÍ (<<, >>)
// Tyto operátory musí být volné funkce (často friend), protože levým operandem je stream.
// ========================================================================================
class Vozidlo {
private:
    string znacka;
    int maximalniRychlost;

public:
    Vozidlo(string z, int r) : znacka(z), maximalniRychlost(r) {}

    // SYNTAXE PRO VÝPIS (friend ostream& operator<<)
    friend ostream& operator<<(ostream& os, const Vozidlo& v) {
        os << "Vozidlo: " << v.znacka << " (Max rychlost: " << v.maximalniRychlost << " km/h)";
        return os; // Nutné pro řetězení cout << a << b;
    }

    // SYNTAXE PRO NAČÍTÁNÍ (friend istream& operator>>)
    // Chybí 'const', protože do objektu zapisujeme.
    friend istream& operator>>(istream& is, Vozidlo& v) {
        is >> v.znacka >> v.maximalniRychlost;
        return is;
    }
};
