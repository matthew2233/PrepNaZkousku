// ========================================================================================
// 5. INKREMENTACE A DEKREMENTACE (++, --)
// Pozor na rozdíl mezi prefixem (++x) a postfixem (x++ - vyžaduje dummy int).
// ========================================================================================
class HerniPostava {
private:
    int level;
public:
    HerniPostava(int l = 1) : level(l) {}

    // 1. PREFIX (++x): Zvýší a vrátí upravený objekt
    // SYNTAXE: Trida& operator++();
    HerniPostava& operator++() {
        this->level++;
        return *this;
    }

    // 2. POSTFIX (x++): Uloží kopii, zvýší originál, vrátí kopii se starou hodnotou
    // SYNTAXE: Trida operator++(int);
    HerniPostava operator++(int) {
        HerniPostava kopie = *this; 
        this->level++;              
        return kopie; // Nevrací se reference!              
    }
};
